{
  "model": "gl_line",
  "access": [
    {
      "name": "read",
      "roles": [
        "gl_reader",
        "gl_accountant",
        "gl_admin"
      ],
      "operations": [
        "read"
      ]
    },
    {
      "name": "post",
      "roles": [
        "gl_accountant",
        "gl_admin"
      ],
      "operations": [
        "create"
      ]
    }
  ],
  "restrict": [
    {
      "name": "sealed",
      "operations": [
        "write",
        "delete"
      ],
      "when": {
        "line_no": {
          "lt": 0
        }
      }
    }
  ],
  "fields": [
    {
      "fields": [
        "entry",
        "line_no",
        "account",
        "debit",
        "credit",
        "party",
        "tax_code",
        "memo",
        "dimensions",
        "date"
      ],
      "write_roles": [
        "via:self"
      ]
    }
  ]
}