{
  "model": "gl_entry",
  "access": [
    {
      "name": "read",
      "roles": [
        "gl_reader",
        "gl_accountant",
        "gl_admin"
      ],
      "operations": [
        "read"
      ]
    },
    {
      "name": "post",
      "roles": [
        "gl_accountant",
        "gl_admin"
      ],
      "operations": [
        "create"
      ]
    }
  ],
  "restrict": [
    {
      "name": "sealed",
      "operations": [
        "write",
        "delete"
      ],
      "when": {
        "seq": {
          "lt": 0
        }
      }
    }
  ]
}
