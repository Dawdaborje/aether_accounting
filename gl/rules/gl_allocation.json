{
  "model": "gl_allocation",
  "access": [
    {
      "name": "read",
      "roles": [
        "gl_reader",
        "gl_accountant",
        "gl_admin"
      ],
      "operations": [
        "read"
      ]
    },
    {
      "name": "match",
      "roles": [
        "gl_accountant",
        "gl_admin"
      ],
      "operations": [
        "create"
      ]
    }
  ],
  "restrict": [
    {
      "name": "sealed",
      "operations": [
        "write",
        "delete"
      ],
      "when": {
        "amount": {
          "lt": -1000000000000
        }
      }
    }
  ],
  "fields": [
    {
      "fields": [
        "amount",
        "debit_line",
        "credit_line",
        "reverses"
      ],
      "write_roles": [
        "via:self"
      ]
    }
  ]
}