{
  "model": "pay_term",
  "access": [
    {
      "name": "read",
      "roles": [
        "pay_clerk",
        "gl.gl_reader",
        "gl.gl_accountant",
        "gl.gl_admin"
      ],
      "operations": [
        "read"
      ]
    },
    {
      "name": "change",
      "roles": [
        "gl.gl_admin"
      ],
      "operations": [
        "create",
        "write"
      ]
    },
    {
      "name": "remove",
      "roles": [
        "gl.gl_admin"
      ],
      "operations": [
        "delete"
      ]
    }
  ],
  "restrict": [
    {
      "name": "sealed",
      "operations": [
        "delete"
      ],
      "when": {
        "name": "~never~"
      }
    }
  ],
  "fields": [
    {
      "fields": [
        "name",
        "net_days",
        "end_of_month",
        "is_active"
      ],
      "write_roles": [
        "via:self"
      ]
    }
  ]
}