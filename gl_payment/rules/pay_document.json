{
  "model": "pay_document",
  "access": [
    {
      "name": "read",
      "roles": [
        "pay_clerk",
        "gl.gl_reader",
        "gl.gl_accountant",
        "gl.gl_admin"
      ],
      "operations": [
        "read"
      ]
    },
    {
      "name": "change",
      "roles": [
        "pay_clerk",
        "gl.gl_accountant",
        "gl.gl_admin"
      ],
      "operations": [
        "create",
        "write"
      ]
    },
    {
      "name": "remove",
      "roles": [
        "gl.gl_admin"
      ],
      "operations": [
        "delete"
      ]
    }
  ],
  "restrict": [
    {
      "name": "sealed",
      "operations": [
        "delete"
      ],
      "when": {
        "key": "~never~"
      }
    }
  ],
  "fields": [
    {
      "fields": [
        "side",
        "source_kind",
        "source_id",
        "key",
        "version",
        "number",
        "party",
        "company",
        "currency",
        "date",
        "due_date",
        "total",
        "gl_line",
        "gl_entry_number",
        "state"
      ],
      "write_roles": [
        "via:self"
      ]
    }
  ]
}