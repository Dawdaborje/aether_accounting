{
  "model": "pay_setting",
  "access": [
    {
      "name": "read",
      "roles": [
        "pay_clerk",
        "gl.gl_reader",
        "gl.gl_accountant",
        "gl.gl_admin"
      ],
      "operations": [
        "read"
      ]
    },
    {
      "name": "change",
      "roles": [
        "gl.gl_admin"
      ],
      "operations": [
        "create",
        "write"
      ]
    },
    {
      "name": "remove",
      "roles": [
        "gl.gl_admin"
      ],
      "operations": [
        "delete"
      ]
    }
  ],
  "restrict": [
    {
      "name": "sealed",
      "operations": [
        "delete"
      ],
      "when": {
        "receivable_account": "~never~"
      }
    }
  ],
  "fields": [
    {
      "fields": [
        "receivable_account",
        "payable_account",
        "receivable_term",
        "payable_term",
        "seq_in",
        "seq_out",
        "four_eyes_out"
      ],
      "write_roles": [
        "via:self"
      ]
    }
  ]
}